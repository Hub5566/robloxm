                if item:FindFirstChild("Main") then
                    if (LP.Character.HumanoidRootPart.CFrame.p - item.Main.CFrame.p).Magnitude > 5 then
                        tp(item.Main.CFrame + Vector3.new(4, 0, 4))
                    end
                    for i = 1, 30 do

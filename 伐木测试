    task.spawn(function()
        CheckLoad = RS.LoadSaveRequests.ClientMayLoad:InvokeServer(LP)
        if not CheckLoad then
            repeat task.wait() until CheckLoad
        end
        RS.LoadSaveRequests.RequestLoad:InvokeServer(slot, LP)
        return slot
    end)

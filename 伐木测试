-- ============================================================
local function cutPart(event, section, height, tool, treeClass)
    local axeStats = getToolStats(tool)
    RS.Interaction.RemoteProxy:FireServer(event, {
        tool = tool,
        faceVector = Vector3.new(-1, 0, 0),
        height = height or 0.3,
        sectionId = section or 1,
        hitPoints = axeStats.Damage or 10,
        cooldown = axeStats.SwingCooldown or 0.1,
        cuttingClass = "Axe"
    })
end

local function getBiggestTree(treeClass)
    local biggest = nil
    local maxSize = 0
    for _, region in pairs(WS:GetChildren()) do
        if region.Name == "TreeRegion" then
            for _, tree in pairs(region:GetChildren()) do
                if tree:FindFirstChild("TreeClass") and tree.TreeClass.Value == treeClass then
                    local ws = tree:FindFirstChild("WoodSection")
                    if ws then
                        local size = ws.Size.X * ws.Size.Y * ws.Size.Z
                        if size > maxSize then
                            maxSize = size
                            biggest = tree
                        end
                    end
                end
            end
        end
    end
    return biggest
end

local function treeListener(treeClass, callback)
    local connection
    connection = WS.LogModels.ChildAdded:Connect(function(child)
        local owner = child:FindFirstChild("Owner")
        if owner and owner.Value == LP and child.TreeClass.Value == treeClass then
            connection:Disconnect()
            callback(child)
        end
    end)
    return connection
end

local function bringTree(treeClass)
    local tool = getBestAxe()
    if not tool then
        Notify("白", "你需要斧头", 4)
        return false
    end

    if treeClass == "LoneCave" and tool.ToolName.Value ~= "EndTimesAxe" then
        Notify("白", "幻影木需要末日斧头", 4)
        return false
    end

    local treeCut = false
    local listener

    listener = treeListener(treeClass, function(tree)
        tree:WaitForChild('Owner', 60)
        tree.PrimaryPart = tree:FindFirstChild("WoodSection")
        treeCut = true

        task.spawn(function()
            for i = 1, 60 do
                RS.Interaction.ClientIsDragging:FireServer(tree)
                task.wait(0.05)
            end
        end)
        task.wait(0.1)

        if tree.PrimaryPart then
            task.spawn(function()
                for i = 1, 60 do
                    tree:PivotTo(bai.treecutset or CFrame.new(0, 0, 0))
                    task.wait(0.05)
                end
            end)
        end

        task.wait(0.5)
        if treeClass == "LoneCave" then
            if LP.Character and LP.Character:FindFirstChild("Head") then
                LP.Character.Head:Destroy()
            end
            LP.CharacterAdded:Wait()
            task.wait(2)
        end

        tp(bai.treecutset)
        if listener then listener:Disconnect() end
    end)

    local tree = getBiggestTree(treeClass)
    if not tree then
        Notify("白", "没有找到树", 3)
        if listener then listener:Disconnect() end
        return false
    end

    local ws = tree:FindFirstChild("WoodSection")
    if not ws then
        Notify("白", "树没有WoodSection", 3)
        if listener then listener:Disconnect() end
        return false
    end

    task.spawn(function()
        local attempts = 0
        while not treeCut and attempts < 100 do
            if not LP.Character then break end
            tp(ws.CFrame + Vector3.new(3, 3, 0))
            cutPart(tree.CutEvent, 1, 0.3, tool, treeClass)
            task.wait(0.1)
            attempts = attempts + 1
        end
        if not treeCut then
            Notify("白", "砍树超时", 3)
            if listener then listener:Disconnect() end
        end
    end)
    return true
end

local function autofarm(treeClass)
    local oldpos = getPosition()
    local tool = getBestAxe()
    if not tool then
        Notify("白", "你需要斧头", 4)
        return
    end

    if treeClass == "LoneCave" and tool.ToolName.Value ~= "EndTimesAxe" then
        Notify("白", "幻影木需要末日斧头", 4)
        return
    end

    local tree = getBiggestTree(treeClass)
    if not tree then
        Notify("白", "没有找到树", 3)
        return
    end

    local treeCut = false
    local treeListenerCon

    treeListenerCon = treeListener(treeClass, function(tree)
        tree.PrimaryPart = tree:FindFirstChild("WoodSection")
        treeCut = true

        for i = 1, 70 do
            RS.Interaction.ClientIsDragging:FireServer(tree.WoodSection)
            tree:MoveTo(oldpos.Position)
            task.wait()
        end
    end)

    task.wait(0.15)

    task.spawn(function()
        repeat
            tp(tree.trunk.CFrame * CFrame.new(4, 3, 4))
            task.wait()
        until treeCut
    end)

    task.wait()

    repeat
        cutPart(tree.tree.CutEvent, 1, 0.3, tool, treeClass)
        task.wait(0.1)
    until treeCut

    if not bai.autofarm1 then
        Notify("白", "完成", 3)
    end
    tp(oldpos)
end


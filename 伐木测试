        if v:FindFirstChild("Owner") and v.Owner.Value == LP then
            if not v.PrimaryPart then
                v.PrimaryPart = v:FindFirstChild("WoodSection")
            end
            task.spawn(function()
                for i = 1, 50 do
                    RS.Interaction.ClientIsDragging:FireServer(v)
                    task.wait(0.05)
                end
            end)
            for i = 1, 50 do
                task.wait(0.05)
                v:PivotTo(Config.treecutset or CFrame.new(0, 0, 0))
            end
        end
    end
end

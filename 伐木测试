    Title = "查看玩家",
    Desc = "相机锁定到目标玩家",
    Value = false,
    Callback = function(state)
        if state then
            local target = Players:FindFirstChild(bai.playernamedied)
            if target and target.Character then
                WS.CurrentCamera.CameraSubject = target.Character.Humanoid
            end
        else
            WS.CurrentCamera.CameraSubject = LP.Character.Humanoid
        end
    end
})

DevilSection:Toggle({
    Title = "查看玩家基地",
    Desc = "相机锁定到目标玩家基地",
    Value = false,
    Callback = function(state)
        local see
        for _, v in pairs(WS.Properties:GetChildren()) do
            if v.Owner.Value == Players:FindFirstChild(bai.playernamedied) then
                see = v.OriginSquare
                break
            end
        end
        if state and see then
            WS.CurrentCamera.CameraSubject = see
        else
            WS.CurrentCamera.CameraSubject = LP.Character.Humanoid
        end
    end
})


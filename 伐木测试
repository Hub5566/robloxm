function gplr(String)
    local Found = {}
    local strl = String:lower()
    if strl == "all" then
        for _, v in pairs(Players:GetPlayers()) do
            table.insert(Found, v)
        end
    elseif strl == "others" then
        for _, v in pairs(Players:GetPlayers()) do
            if v.Name ~= LP.Name then
                table.insert(Found, v)
            end
        end
    elseif strl == "me" then
        for _, v in pairs(Players:GetPlayers()) do
            if v.Name == LP.Name then
                table.insert(Found, v)
            end
        end
    else
        for _, v in pairs(Players:GetPlayers()) do
            if v.Name:lower():sub(1, #String) == String:lower() then
                table.insert(Found, v)
            end
        end
    end
    return Found
end


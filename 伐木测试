function finditem(o)
    for _, h in pairs(WS.Stores:GetChildren()) do
        if h.Name == "ShopItems" and h:FindFirstChild("Box") then
            for _, j in pairs(h:GetChildren()) do
                if j.BoxItemName.Value == o then
                    for _, w in pairs(h:GetChildren()) do
                        if w.BoxItemName.Value == "Sawmill" or w.BoxItemName.Value == "Sawmill2" then
                            ID = GetShopID.WoodRus
                            Cashier = WS.Stores.WoodRUs.Thom.HumanoidRootPart.CFrame
                            Counter = WS.Stores.WoodRUs.Counter.CFrame + Vector3.new(0, .4, 0)
                        elseif w.BoxItemName.Value == "Trailer2" or w.BoxItemName.Value == "UtilityTruck2" then
                            ID = GetShopID.CarStore
                            Cashier = WS.Stores.CarStore.Jenny.HumanoidRootPart.CFrame
                            Counter = WS.Stores.CarStore.Counter.CFrame + Vector3.new(0, .4, 0)
                        elseif w.BoxItemName.Value == "CanOfWorms" or w.BoxItemName.Value == "Dynamite" then
                            ID = GetShopID.ShackShop
                            Cashier = WS.Stores.ShackShop.Bob.HumanoidRootPart.CFrame
                            Counter = WS.Stores.ShackShop.Counter.CFrame + Vector3.new(0, .4, 0)
                        elseif w.BoxItemName.Value == "GateXOR" or w.BoxItemName.Value == "NeonWireOrange" then
                            ID = GetShopID.LogicStore
                            Cashier = WS.Stores.LogicStore.Lincoln.HumanoidRootPart.CFrame
                            Counter = WS.Stores.LogicStore.Counter.CFrame + Vector3.new(0, .4, 0)
                        end
                    end
                    return { j, Cashier, ID, Counter }
                end
            end
        end
    end
end

function autobuyv2(o)
    local item = finditem(o)
    if item == nil then
        Notify("白", "没有找到商品或者没有刷新，请你等待", 4)
        repeat
            task.wait()
            item = finditem(o)
        until item ~= nil
    end

    local ltem = item[1]
    tp(ltem.Main.CFrame)
    task.wait()

    RunService.Stepped:wait()
    for e = 1, 15 do
        RS.Interaction.ClientIsDragging:FireServer(ltem)
        ltem:PivotTo(item[4])
        RS.Interaction.ClientIsDragging:FireServer(ltem)
        RunService.Stepped:wait()
    end
    tp(item[4] + Vector3.new(5, 0, 5))

    repeat
        BuyItem(item[3])
        RunService.Stepped:wait()
    until tostring(ltem.Parent) ~= "ShopItems"

    return o
end

function autobuy(o, r)
    bai.autocsdx = WS.PlayerModels.ChildAdded:Connect(function(v)
        v:WaitForChild('Owner', 60)
        if v.Owner.Value == LP then
            for i = 1, 20 do
                RS.Interaction.ClientIsDragging:FireServer(v)
                v:PivotTo(bai.autobuyset)
                RS.Interaction.ClientIsDragging:FireServer(v)
                RunService.Stepped:wait()
            end
        end
    end)
    for e = 1, r do
        if not bai.autobuystop then
            autobuyv2(o)
            task.wait()
        end
    end
    task.spawn(function()
        task.wait(1)
        if bai.autocsdx then
            bai.autocsdx:Disconnect()
            bai.autocsdx = nil
        end
    end)
    return o, r
end


-- 树类型修改函数
-- ============================================================
local function modifyTreeType(targetType, newType)
    local tool = getBestAxe(targetType)
    if not tool then return false end

    local treeCut = false
    local listener
    
    listener = treeListener(targetType, function(tree)
        tree:WaitForChild('Owner', 60)
        tree.PrimaryPart = tree:FindFirstChild("WoodSection")
        treeCut = true

        if tree:FindFirstChild("TreeClass") then
            tree.TreeClass.Value = newType
            Notify("修改成功", "树类型已修改", 2)
        end

        task.spawn(function()
            for i = 1, 60 do
                RS.Interaction.ClientIsDragging:FireServer(tree)
                task.wait()
            end
        end)
        task.wait(0.1)
        
        if tree.PrimaryPart then
            spawn(function()
                for i = 1, 60 do
                    tree:PivotTo(Config.treecutset or CFrame.new(0, 0, 0))
                    task.wait()
                end
            end)
        end

        tp(Config.treecutset)
        if listener then listener:Disconnect() end
    end)

    local tree = getBiggestTree(targetType)
    if not tree then
        Notify("错误", "没有找到目标树", 3)
        if listener then listener:Disconnect() end
        return false
    end

    local ws = tree:FindFirstChild("WoodSection")
    if not ws then
        Notify("错误", "树没有WoodSection", 3)
        if listener then listener:Disconnect() end
        return false
    end

    spawn(function()
        local attempts = 0
        while not treeCut and attempts < 100 do
            tp(ws.CFrame + Vector3.new(3, 3, 0))
            cutPart(tree.CutEvent, 1, 0.3, tool, targetType)
            task.wait(0.1)
            attempts = attempts + 1
        end
        if not treeCut then
            Notify("超时", "修改树类型超时", 3)
            if listener then listener:Disconnect() end
        end
    end)

    return true
end

local function getAllTrees()
    local trees = {}
    for _, region in pairs(WS:GetChildren()) do
        if region.Name == "TreeRegion" then
            for _, tree in pairs(region:GetChildren()) do
                if tree:FindFirstChild("TreeClass") and tree:FindFirstChild("WoodSection") then
                    table.insert(trees, tree)
                end
            end
        end
    end
    return trees
end

local function batchModifyTrees(targetType, newType)
    local trees = getAllTrees()
    local count = 0
    for _, tree in pairs(trees) do
        if tree.TreeClass.Value == targetType then
            tree.TreeClass.Value = newType
            count = count + 1
            task.wait(0.05)
        end
    end
    return count
end


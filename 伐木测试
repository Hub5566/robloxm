-- 循环控制
-- ============================================================
local function startFarm()
    if Config.farmLoop then return end
    Config.farmLoop = task.spawn(function()
        while Config.autofarm do
            bringTree(Config.cuttreeselect)
            task.wait(0.5)
        end
    end)
end

local function stopFarm()
    Config.autofarm = false
    if Config.farmLoop then
        task.cancel(Config.farmLoop)
        Config.farmLoop = nil
    end
end

local function startSell()
    if Config.sellLoop then return end
    Config.sellLoop = task.spawn(function()
        while Config.autosell do
            sellWood()
            task.wait(2)
        end
    end)
end

local function stopSell()
    Config.autosell = false
    if Config.sellLoop then
        task.cancel(Config.sellLoop)
        Config.sellLoop = nil
    end
end

local function startMoney()
    if Config.moneyLoop then return end
    Config.autofarm = true
    Config.autosell = true
    startFarm()
    startSell()
end

local function stopMoney()
    Config.autofarm1 = false
    stopFarm()
    stopSell()
end


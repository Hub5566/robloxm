-- ===== 按标签/分类批量选择 =====
ItemSection:Button({
    Title = "📂 按分类批量选择",
    Desc = "选择所有相同分类的物品（结构/工具/蓝图等）",
    Callback = function()
        if Config.cswjia == "" then
            Notify("错误", "请先输入目标玩家名称", 3)
            return
        end
        
        -- 获取所有可用的分类
        local categories = {}
        for _, v in pairs(WS.PlayerModels:GetChildren()) do
            if v:FindFirstChild("Owner") and tostring(v.Owner.Value) == Config.cswjia then
                if v:FindFirstChild("Type") then
                    local cat = v.Type.Value
                    if not categories[cat] then
                        categories[cat] = true
                    end
                end
            end
        end
        
        local catList = {}
        for cat, _ in pairs(categories) do
            table.insert(catList, cat)
        end
        
        if #catList == 0 then
            Notify("错误", "没有找到可分类的物品", 3)
            return
        end
        
        -- 显示分类选择通知
        local msg = "请选择分类:\n"
        for i, cat in ipairs(catList) do
            msg = msg .. i .. ". " .. cat .. "\n"
        end
        msg = msg .. "输入数字选择"
        
        Notify("分类选择", msg, 5)
        
        local input = Instance.new("TextBox")
        input.Size = UDim2.new(0, 200, 0, 30)
        input.Position = UDim2.new(0.5, -100, 0.5, -15)
        input.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
        input.TextColor3 = Color3.fromRGB(255, 255, 255)
        input.PlaceholderText = "输入数字 (1-" .. #catList .. ")"
        input.Font = Enum.Font.Gotham
        input.TextSize = 16
        input.Parent = game.CoreGui
        
        input.FocusLost:Connect(function(enterPressed)
            if enterPressed then
                local num = tonumber(input.Text)
                if num and num >= 1 and num <= #catList then
                    local selectedCat = catList[num]
                    
                    -- 清除之前的选择
                    for _, v in pairs(WS.PlayerModels:GetChildren()) do
                        if v:FindFirstChild("SelectionBox") then
                            v.SelectionBox:Destroy()
                        end
                    end
                    
                    local count = 0
                    for _, v in pairs(WS.PlayerModels:GetChildren()) do
                        if v:FindFirstChild("Owner") and tostring(v.Owner.Value) == Config.cswjia then
                            if v:FindFirstChild("Type") and v.Type.Value == selectedCat then
                                local SB = Instance.new("SelectionBox", v)
                                SB.Adornee = v
                                SB.Color3 = Color3.fromRGB(255, 0, 255)
                                count = count + 1
                            end
                        end
                    end
                    
                    Notify("完成", "已选择 " .. count .. " 个分类为 " .. selectedCat .. " 的物品", 3)
                else
                    Notify("错误", "无效的数字", 2)
                end
                input:Destroy()
            end
        end)
        
        -- 自动关闭
        task.delay(10, function()
            if input then
                input:Destroy()
            end
        end)
    end
})


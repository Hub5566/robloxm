ItemSection:Button({
    Title = "获得物品传送工具",
    Desc = "点击物品传送到传送点",
    Callback = function()
        if Config.itemset == nil then
            Notify("错误", "请先设置传送点", 3)
            return
        end
        if Config.cswjia == "" then
            Notify("错误", "请先输入目标玩家名称", 3)
            return
        end
        local tool = Instance.new("Tool", LP.Backpack)
        tool.Name = "点击传送物品"
        tool.RequiresHandle = false
        local mouse = LP:GetMouse()
        tool.Activated:Connect(function()
            local target = mouse.Target
            if not target then return end
            local item = target.Parent
            if item:FindFirstChild("Owner") and tostring(item.Owner.Value) == Config.cswjia then
                if item:FindFirstChild("Main") then
                    if (LP.Character.HumanoidRootPart.CFrame.p - item.Main.CFrame.p).Magnitude > 5 then
                        tp(item.Main.CFrame + Vector3.new(4, 0, 4))
                    end
                    for i = 1, 30 do
                        RS.Interaction.ClientIsDragging:FireServer(item)
                        item.Main.CFrame = Config.itemset
                        RS.Interaction.ClientIsDragging:FireServer(item)
                        task.wait()
                    end
                    Notify("完成", "已传送物品", 2)
                elseif item:FindFirstChild("WoodSection") then
                    tp(item.WoodSection.CFrame + Vector3.new(4, 0, 4))
                    for i = 1, 30 do
                        RS.Interaction.ClientIsDragging:FireServer(item)
                        item.WoodSection.CFrame = Config.itemset
                        RS.Interaction.ClientIsDragging:FireServer(item)
                        task.wait()
                    end
                    Notify("完成", "已传送物品", 2)
                else
                    Notify("错误", "无法识别该物品", 2)
                end
            else
                Notify("错误", "该物品不属于目标玩家", 2)
            end
        end)
        Notify("工具", "已获得物品传送工具（点击物品传送）", 2)
    end
})


-- ============================================================
local function Notify(Title, Text, Duration)
    Duration = Duration or 3
    print(string.format("[%s] %s", Title, Text))
    local success, err = pcall(function()
        if WindUI and WindUI.Notify then
            WindUI:Notify({
                Title = Title,
                Content = Text,
                Duration = Duration
            })
        end
    end)
    if not success then
        warn("Notify失败: " .. tostring(err))
    end
end


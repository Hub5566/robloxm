-- ============================================================
-- 工具函数
-- ============================================================
local function getTools()
    local tools = {}
    if not LP.Character then return tools end
    for _, v in pairs(LP.Backpack:GetChildren()) do
        if v:IsA("Tool") and v:FindFirstChild("ToolName") then
            table.insert(tools, v)
        end
    end
    local char = LP.Character
    if char then
        local tool = char:FindFirstChildOfClass("Tool")
        if tool and tool:FindFirstChild("ToolName") then
            table.insert(tools, tool)
        end
    end
    return tools
end

local function getToolStats(toolName)
    if typeof(toolName) ~= "string" then
        toolName = toolName.ToolName.Value
    end
    return require(RS.AxeClasses['AxeClass_' .. toolName]).new()
end

local function getBestAxe(treeClass)
    local tools = getTools()
    if #tools == 0 then
        Notify("错误", "你需要斧头", 3)
        return nil
    end
    
    if treeClass == "LoneCave" then
        for _, v in pairs(tools) do
            if v.ToolName.Value == "EndTimesAxe" then
                return v
            end
        end
        Notify("错误", "幻影木需要末日斧头", 3)
        return nil
    end
    
    local sorted = {}
    for _, v in pairs(tools) do
        local stats = getToolStats(v)
        table.insert(sorted, {
            tool = v,
            damage = stats.Damage
        })
    end
    table.sort(sorted, function(a, b)
        return a.damage > b.damage
    end)
    
    return sorted[1].tool
end

local function cutPart(event, section, height, tool, treeClass)
    local axeStats = getToolStats(tool)
    RS.Interaction.RemoteProxy:FireServer(event, {
        tool = tool,
        faceVector = Vector3.new(-1, 0, 0),
        height = height or 0.3,
        sectionId = section or 1,
        hitPoints = axeStats.Damage or 10,
        cooldown = axeStats.SwingCooldown or 0.1,
        cuttingClass = "Axe"
    })
end

local function getBiggestTree(treeClass)
    local biggest = nil
    local maxSize = 0
    for _, region in pairs(WS:GetChildren()) do
        if region.Name == "TreeRegion" then
            for _, tree in pairs(region:GetChildren()) do
                if tree:FindFirstChild("TreeClass") and tree.TreeClass.Value == treeClass then
                    local ws = tree:FindFirstChild("WoodSection")
                    if ws then
                        local size = ws.Size.X * ws.Size.Y * ws.Size.Z
                        if size > maxSize then
                            maxSize = size
                            biggest = tree
                        end
                    end
                end
            end
        end
    end
    return biggest
end

local function treeListener(treeClass, callback)
    local connection
    connection = WS.LogModels.ChildAdded:Connect(function(child)
        local owner = child:WaitForChild("Owner")
        if owner.Value == LP and child.TreeClass.Value == treeClass then
            connection:Disconnect()
            callback(child)
        end
    end)
    return connection
end

local function tp(pos)
    if not LP.Character then return end
    local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if typeof(pos) == "CFrame" then
        hrp.CFrame = pos
    elseif typeof(pos) == "Vector3" then
        hrp.Position = pos
    end
end

local function carTeleport(cframe)
    if LP.Character then
        local humanoid = LP.Character:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.SeatPart then
            local Car = humanoid.SeatPart.Parent
            spawn(function()
                for i = 1, 5 do
                    task.wait()
                    Car:SetPrimaryPartCFrame(cframe)
                    RS.Interaction.ClientRequestOwnership:FireServer(Car.Main)
                    RS.Interaction.ClientIsDragging:FireServer(Car.Main)
                end
            end)
        end
    end
end

-- ============================================================
-- 核心砍树函数
-- ============================================================
local function bringTree(treeClass)
    local tool = getBestAxe(treeClass)
    if not tool then return false end

    local treeCut = false
    local listener
    
    listener = treeListener(treeClass, function(tree)
        tree:WaitForChild('Owner', 60)
        tree.PrimaryPart = tree:FindFirstChild("WoodSection")
        treeCut = true

        task.spawn(function()
            for i = 1, 60 do
                RS.Interaction.ClientIsDragging:FireServer(tree)
                task.wait()
            end
        end)
        task.wait(0.1)
        
        if tree.PrimaryPart then
            spawn(function()
                for i = 1, 60 do
                    tree:PivotTo(Config.treecutset or CFrame.new(0, 0, 0))
                    task.wait()
                end
            end)
        end

        wait(0.5)
        if treeClass == "LoneCave" then
            LP.Character.Head:Destroy()
            LP.CharacterAdded:Wait()
            wait(2)
        end
        tp(Config.treecutset)
        if listener then listener:Disconnect() end
    end)

    local tree = getBiggestTree(treeClass)
    if not tree then
        Notify("错误", "没有找到树", 3)
        if listener then listener:Disconnect() end
        return false
    end

    local ws = tree:FindFirstChild("WoodSection")
    if not ws then
        Notify("错误", "树没有WoodSection", 3)
        if listener then listener:Disconnect() end
        return false
    end

    spawn(function()
        local attempts = 0
        while not treeCut and attempts < 100 do
            tp(ws.CFrame + Vector3.new(3, 3, 0))
            cutPart(tree.CutEvent, 1, 0.3, tool, treeClass)
            task.wait(0.1)
            attempts = attempts + 1
        end
        if not treeCut then
            Notify("超时", "砍树超时", 3)
            if listener then listener:Disconnect() end
        end
    end)

    return true
end

local function bringTreeWithCount(treeClass, count)
    Config.bringtree = true
    Config.treecutset = LP.Character.HumanoidRootPart.CFrame
    task.wait(0.2)
    for i = 1, count do
        if Config.bringtree == false then break end
        task.wait()
        bringTree(treeClass)
    end
    Config.bringtree = false
end


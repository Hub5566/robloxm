local buyCooldown = false
local function buyItem(itemName, quantity)
    if buyCooldown then return end
    buyCooldown = true
    Notify("商店", "正在购买: " .. itemName, 3)
    task.spawn(function()
        for i = 1, quantity do
            RS.Interaction.RemoteProxy:FireServer("BuyItem", itemName)
            task.wait(0.2)
        end
        Notify("商店", "购买完成", 2)
        task.wait(0.5)
        buyCooldown = false
    end)
end

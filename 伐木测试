function is_in_frame(screenpos, frame)
    local xPos = frame.AbsolutePosition.X
    local yPos = frame.AbsolutePosition.Y
    local xSize = frame.AbsoluteSize.X
    local ySize = frame.AbsoluteSize.Y
    
    local check1 = screenpos.X >= xPos and screenpos.X <= xPos + xSize
    local check3 = screenpos.Y >= yPos and screenpos.Y <= yPos + ySize
    local check2 = screenpos.X <= xPos and screenpos.X >= xPos + xSize
    local check4 = screenpos.Y <= yPos and screenpos.Y >= yPos + ySize
    
    return (check1 and check3) or (check2 and check3) or (check1 and check4) or (check2 and check4)
end

local function startItemTransfer()
    if Config.itemset == nil then
        Notify("错误", "请先设置传送点", 4)
        return
    end
    Config.cskais = true
    local OldPos = LP.Character.HumanoidRootPart.CFrame
    
    for _, v in pairs(WS.PlayerModels:GetChildren()) do
        if Config.cskais == false then break end
        if v:FindFirstChild("Owner") and tostring(v.Owner.Value) == Config.cswjia then
            if v:FindFirstChild("SelectionBox") then
                if v:FindFirstChild("Main") then
                    if (LP.Character.HumanoidRootPart.CFrame.p - v.Main.CFrame.p).Magnitude > 5 then
                        tp(v.Main.CFrame + Vector3.new(4, 0, 4))
                    end
                    for i = 1, 30 do
                        if Config.cskais == false then break end
                        RS.Interaction.ClientIsDragging:FireServer(v)
                        v:PivotTo(Config.itemset)
                        RS.Interaction.ClientIsDragging:FireServer(v)
                        task.wait()
                    end
                    v.SelectionBox:Destroy()
                elseif v:FindFirstChild("WoodSection") then
                    tp(v.WoodSection.CFrame + Vector3.new(4, 0, 4))
                    for i = 1, 70 do
                        if Config.cskais == false then break end
                        RS.Interaction.ClientIsDragging:FireServer(v)
                        v.WoodSection.CFrame = Config.itemset * CFrame.Angles(math.rad(90), 0, 90)
                        RS.Interaction.ClientIsDragging:FireServer(v)
                        task.wait()
                    end
                    v.SelectionBox:Destroy()
                end
            end
        end
    end
    tp(OldPos)
    Config.cskais = false
    Notify("完成", "已传送所有选中物品", 2)
end

-- ============================================================
-- 核心砍树函数
-- ============================================================
local function bringTree(treeClass)
    local tool = getBestAxe(treeClass)
    if not tool then return false end

    local treeCut = false
    local listener
    
    listener = treeListener(treeClass, function(tree)
        tree:WaitForChild('Owner', 60)
        tree.PrimaryPart = tree:FindFirstChild("WoodSection")
        treeCut = true

        task.spawn(function()
            for i = 1, 60 do
                RS.Interaction.ClientIsDragging:FireServer(tree)
                task.wait()
            end
        end)
        task.wait(0.1)
        
        if tree.PrimaryPart then
            spawn(function()
                for i = 1, 60 do
                    tree:PivotTo(Config.treecutset or CFrame.new(0, 0, 0))
                    task.wait()
                end
            end)
        end

        wait(0.5)
        if treeClass == "LoneCave" then
            LP.Character.Head:Destroy()
            LP.CharacterAdded:Wait()
            wait(2)
        end
        tp(Config.treecutset)
        if listener then listener:Disconnect() end
    end)

    local tree = getBiggestTree(treeClass)
    if not tree then
        Notify("错误", "没有找到树", 3)
        if listener then listener:Disconnect() end
        return false
    end

    local ws = tree:FindFirstChild("WoodSection")
    if not ws then
        Notify("错误", "树没有WoodSection", 3)
        if listener then listener:Disconnect() end
        return false
    end

    spawn(function()
        local attempts = 0
        while not treeCut and attempts < 100 do
            tp(ws.CFrame + Vector3.new(3, 3, 0))
            cutPart(tree.CutEvent, 1, 0.3, tool, treeClass)
            task.wait(0.1)
            attempts = attempts + 1
        end
        if not treeCut then
            Notify("超时", "砍树超时", 3)
            if listener then listener:Disconnect() end
        end
    end)

    return true
end

local function bringTreeWithCount(treeClass, count)
    Config.bringtree = true
    Config.treecutset = LP.Character.HumanoidRootPart.CFrame
    task.wait(0.2)
    for i = 1, count do
        if Config.bringtree == false then break end
        task.wait()
        bringTree(treeClass)
    end
    Config.bringtree = false
end


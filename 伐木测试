function CheckIfSlotAvailable(Slot)
    for a, b in pairs(RS.LoadSaveRequests.GetMetaData:InvokeServer(LP)) do
        if a == Slot then
            for c, d in pairs(b) do
                if c == "NumSaves" and d ~= 0 then
                    return true
                end
            end
        end
    end
    return false
end


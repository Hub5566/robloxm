-- 飞行功能
local flyVel = nil
local function toggleFly(state)
    Config.flyEnabled = state
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if state then
        if not flyVel then
            flyVel = Instance.new("BodyVelocity")
            flyVel.MaxForce = Vector3.new(1, 1, 1) * 100000
            flyVel.Parent = hrp
            flyVel.Velocity = Vector3.new(0, 0, 0)
        end
        if char:FindFirstChild("Humanoid") then
            char.Humanoid.PlatformStand = true
        end
    else
        if flyVel then
            flyVel:Destroy()
            flyVel = nil
        end
        if char:FindFirstChild("Humanoid") then
            char.Humanoid.PlatformStand = false
        end
    end
end
-- 飞行控制
local flySpeed = 50
UserInputService.InputBegan:Connect(function(input, processed)
    if not processed and Config.flyEnabled and LP.Character then
        local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
        if not hrp or not flyVel then return end

        local moveVec = Vector3.new(0, 0, 0)
        if input.KeyCode == Enum.KeyCode.W then moveVec = moveVec + hrp.CFrame.LookVector * flySpeed end
        if input.KeyCode == Enum.KeyCode.S then moveVec = moveVec - hrp.CFrame.LookVector * flySpeed end
        if input.KeyCode == Enum.KeyCode.A then moveVec = moveVec - hrp.CFrame.RightVector * flySpeed end
        if input.KeyCode == Enum.KeyCode.D then moveVec = moveVec + hrp.CFrame.RightVector * flySpeed end
        if input.KeyCode == Enum.KeyCode.Space then moveVec = moveVec + Vector3.new(0, flySpeed, 0) end
        if input.KeyCode == Enum.KeyCode.LeftShift then moveVec = moveVec - Vector3.new(0, flySpeed, 0) end

        flyVel.Velocity = moveVec
    end
end)

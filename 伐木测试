        makebase(CFrame.new(spos.X, spos.Y, spos.Z - 40))
        makebase(CFrame.new(spos.X + 80, spos.Y, spos.Z))
        makebase(CFrame.new(spos.X - 80, spos.Y, spos.Z))
        makebase(CFrame.new(spos.X, spos.Y, spos.Z + 80))

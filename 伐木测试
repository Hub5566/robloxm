    end
    return aS
end

local function tp(pos)
    if not LP.Character then return end
    local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if typeof(pos) == "CFrame" then
        hrp.CFrame = pos
    elseif typeof(pos) == "Vector3" then
        hrp.Position = pos
    end
end

local function carTeleport(cframe)
    if not LP.Character then return end
    local char = LP.Character
    if char.Humanoid.SeatPart ~= nil then
        local car = char.Humanoid.SeatPart.Parent
        task.spawn(function()
            for i = 1, 5 do
                task.wait()
                pcall(function()
                    car:SetPrimaryPartCFrame(cframe * CFrame.Angles(
                        math.rad(char.HumanoidRootPart.Orientation.X),
                        math.rad(char.HumanoidRootPart.Orientation.Y), 0
                    ))
                    RS.Interaction.ClientRequestOwnership:FireServer(car.Main)
                    RS.Interaction.ClientIsDragging:FireServer(car.Main)
                end)
            end
        end)
    end
end


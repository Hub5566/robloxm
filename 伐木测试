-- ============================================================
-- 转钱功能
-- ============================================================
local function donate(plr, amount)
    if tostring(plr) == tostring(LP) then
        Notify("错误", "不能给自己转钱", 3)
        return
    end
    if not Players:FindFirstChild(plr) then
        Notify("错误", "没有找到玩家", 3)
        return
    end
    amount = tonumber(amount) or 1
    if amount <= 0 then
        Notify("错误", "金额必须大于0", 3)
        return
    end
    if amount > LP.leaderstats.Money.Value then
        Notify("错误", "你没有足够的钱", 3)
        return
    end
    if LP.CurrentSaveSlot.Value <= 0 then
        Notify("错误", "基地没有加载", 3)
        return
    end
    
    local target = Players:FindFirstChild(plr)
    if not target then return end
    
    local oldAmount = target.leaderstats.Money.Value
    RS.Transactions.ClientToServer.Donate:InvokeServer(target, amount, LP.CurrentSaveSlot.Value)
    task.wait(1)
    
    if target.leaderstats.Money.Value ~= oldAmount + amount then
        Notify("错误", "转钱失败，可能正在冷却", 3)
        return
    end
    Notify("完成", "已转 " .. amount .. " 给 " .. plr, 3)
end


-- ===== 物品传送标签页（完整版） =====
local ItemTab = Window:Tab({ Title = "物品传送" })

local ItemSection = ItemTab:Section({ Title = "物品传送设置" })

ItemSection:Input({
    Title = "目标玩家名称",
    Desc = "输入要传送物品的玩家名",
    Placeholder = "输入玩家名",
    Callback = function(value)
        Config.cswjia = value
        Notify("设置", "目标玩家: " .. value, 2)
    end
})

ItemSection:Button({
    Title = "设置传送点",
    Desc = "在当前位置设置传送点",
    Callback = function()
        if not LP.Character then
            Notify("错误", "角色不存在", 3)
            return
        end
        pcall(function()
            if WS:FindFirstChild("baiBasedropCord") then
                WS.baiBasedropCord:Destroy()
            end
        end)
        local cord = Instance.new("Part", WS)
        cord.Name = "baiBasedropCord"
        cord.CanCollide = false
        cord.Anchored = true
        cord.Shape = Enum.PartType.Ball
        cord.Color = Color3.fromRGB(0, 217, 255)
        cord.Size = Vector3.new(2, 2, 2)
        cord.CFrame = LP.Character.HumanoidRootPart.CFrame
        cord.Material = Enum.Material.Marble
        Config.itemset = LP.Character.HumanoidRootPart.CFrame
        Notify("完成", "已设置传送点", 2)
    end
})

ItemSection:Button({
    Title = "删除传送点",
    Desc = "删除传送点",
    Callback = function()
        pcall(function()
            if WS:FindFirstChild("baiBasedropCord") then
                WS.baiBasedropCord:Destroy()
            end
            Config.itemset = nil
        end)
        Notify("完成", "已删除传送点", 2)
    end
})

-- ===== 批量选择相同属性物品 =====
ItemSection:Button({
    Title = "📦 批量选择相同物品",
    Desc = "点击一个物品，自动选择所有相同类型的物品",
    Callback = function()
        if Config.cswjia == "" then
            Notify("错误", "请先输入目标玩家名称", 3)
            return
        end
        
        Notify("提示", "点击一个物品来选择所有相同类型", 3)
        local done = false
        local conn = Mouse.Button1Up:Connect(function()
            local clicked = Mouse.Target
            if not clicked then return end
            
            local item = clicked.Parent
            if not item:FindFirstChild("Owner") then
                item = item.Parent
                if not item or not item:FindFirstChild("Owner") then
                    Notify("错误", "请点击一个物品", 2)
                    return
                end
            end
            
            if tostring(item.Owner.Value) ~= Config.cswjia then
                Notify("错误", "该物品不属于目标玩家", 2)
                return
            end
            
            -- 获取物品的唯一标识
            local itemIdentifier = nil
            local itemType = nil
            
            -- 检测物品类型
            if item:FindFirstChild("PurchasedBoxItemName") then
                itemIdentifier = item.PurchasedBoxItemName.Value
                itemType = "PurchasedBoxItemName"
            elseif item:FindFirstChild("ItemName") then
                itemIdentifier = item.ItemName.Value
                itemType = "ItemName"
            elseif item:FindFirstChild("Type") then
                itemIdentifier = item.Type.Value
                itemType = "Type"
            elseif item:FindFirstChild("ToolName") then
                itemIdentifier = item.ToolName.Value
                itemType = "ToolName"
            elseif item:FindFirstChild("TreeClass") then
                itemIdentifier = item.TreeClass.Value
                itemType = "TreeClass"
            elseif item:FindFirstChild("WoodSection") then
                itemIdentifier = "WoodSection"
                itemType = "WoodSection"
            else
                Notify("错误", "无法识别该物品类型", 2)
                return
            end
            
            -- 清除之前的选择
            for _, v in pairs(WS.PlayerModels:GetChildren()) do
                if v:FindFirstChild("SelectionBox") then
                    v.SelectionBox:Destroy()
                end
            end
            
            -- 选择所有相同类型的物品
            local count = 0
            for _, v in pairs(WS.PlayerModels:GetChildren()) do
                if v:FindFirstChild("Owner") and tostring(v.Owner.Value) == Config.cswjia then
                    local match = false
                    
                    if itemType == "PurchasedBoxItemName" and v:FindFirstChild("PurchasedBoxItemName") then
                        if v.PurchasedBoxItemName.Value == itemIdentifier then
                            match = true
                        end
                    elseif itemType == "ItemName" and v:FindFirstChild("ItemName") then
                        if v.ItemName.Value == itemIdentifier then
                            match = true
                        end
                    elseif itemType == "Type" and v:FindFirstChild("Type") then
                        if v.Type.Value == itemIdentifier then
                            match = true
                        end
                    elseif itemType == "ToolName" and v:FindFirstChild("ToolName") then
                        if v.ToolName.Value == itemIdentifier then
                            match = true
                        end
                    elseif itemType == "TreeClass" and v:FindFirstChild("TreeClass") then
                        if v.TreeClass.Value == itemIdentifier then
                            match = true
                        end
                    elseif itemType == "WoodSection" and v:FindFirstChild("WoodSection") then
                        match = true
                    end
                    
                    if match then
                        local SB = Instance.new("SelectionBox", v)
                        SB.Adornee = v
                        SB.Color3 = Color3.fromRGB(0, 255, 0)
                        count = count + 1
                    end
                end
            end
            
            done = true
            Notify("完成", "已选择 " .. count .. " 个相同类型的物品", 3)
            conn:Disconnect()
        end)
        
        repeat task.wait() until done
    end
})


local duplicationEnabled = false
local dupeLoop = nil
local function startDuplication(itemName, count)
    if duplicationEnabled then return end
    duplicationEnabled = true

    Notify("复制", "正在复制物品: " .. itemName, 3)
    dupeLoop = task.spawn(function()
        local attempts = 0
        while duplicationEnabled and attempts < count do
            for _, v in pairs(WS.LogModels:GetChildren()) do
                if not v:IsDescendantOf(game) then continue end
                if v:FindFirstChild("Owner") and v.Owner.Value == LP then
                    if v.Name == itemName or itemName == "" then
                        local clone = v:Clone()
                        clone.Parent = WS.LogModels
                        if clone:FindFirstChild("Owner") then
                            clone.Owner.Value = LP
                        end
                        task.wait(0.1)
                        attempts = attempts + 1
                        if attempts >= count then
                            break
                        end
                    end
                end
            end
            task.wait(0.5)
        end
        duplicationEnabled = false
        Notify("复制", "完成复制 " .. attempts .. " 个物品", 3)
    end)
end
local function stopDuplication()
    duplicationEnabled = false
    if dupeLoop then
        task.cancel(dupeLoop)
        dupeLoop = nil
    end
    Notify("复制", "已停止复制", 2)
end
